# Generate keys with: python scripts/gen_keys.py
SECRET_KEY=change-me
ENCRYPTION_KEY=change-me

APP_DATABASE_URL=sqlite+aiosqlite:///./querychat.db
# migrate (Alembic, default) | create_all (throwaway DBs only)
DB_BOOTSTRAP=migrate
CORS_ORIGINS=["http://localhost:3000"]
COOKIE_SECURE=false

OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_FAST_MODEL=gpt-4o-mini

AGENT_MAX_RETRIES=3

# Dev: true. Hosted / multi-tenant: false (blocks private IPs and restricts SQLite paths).
ALLOW_PRIVATE_HOSTS=true
SQLITE_ALLOWED_DIR=

# Logging: backend/logs/server.log (rotating). Set LOG_TO_FILE=false to log to the console only.
LOG_LEVEL=INFO
LOG_TO_FILE=true
# LOG_DIR=
# LOG_MAX_MB=5
# LOG_BACKUPS=5
